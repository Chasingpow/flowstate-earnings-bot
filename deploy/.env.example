# Copy to .env and fill in. Keep this file private (chmod 600 .env).
FMP_API_KEY=your_fmp_key_here
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# Chromium for card rendering (bootstrap sets this for you)
CHROME_BIN=/usr/bin/chromium-browser

# Which caps to post (2B = mid+large+mega). Same meaning as the cron bot.
MIN_MARKET_CAP=2000000000

# Timing knobs (defaults are sensible)
EDGAR_POLL_SEC=20
ACTUALS_POLL_SEC=45
ACTUALS_TIMEOUT_MIN=90
WATCHLIST_REFRESH_MIN=30
HEARTBEAT_MIN=15

# 1 = also parse preliminary EPS/revenue from the press release into the instant
# ping. Off by default — turn on once you trust the parse.
PARSE_PRELIM=0

# Optional: on startup, post one full card for this ticker to prove the VM can
# render + post. Leave blank for normal operation.
SELFTEST_TICKER=

# SEC requires a User-Agent with contact info.
SEC_USER_AGENT=FlowstateAlpha earnings-bot (contact: keithharasymiw@gmail.com)
